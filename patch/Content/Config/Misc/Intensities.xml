<!--


NOTES:


The only possible event outcomes for failed Storyline event completion are defined as 
individual 'afterEvent' blocks. If only one is defined, that is the only one which 
will be picked, and no further loss will occur.


A 'stopMoodDrop' block can be used to further control how much impact an ungranted 
Desire has on a Clan's Mood.


The 'extraLossChance' field inside a 'stopMoodDrop' block can be used to randomly 
have the Mood drop by an additional -1.


-->
<intensitys>
  <!--*******************************-->
  <!--                               -->
  <!--      Curious                  -->
  <!--                               -->
  <intensity>
    <ID>INTENSITY_CURIOUS</ID>
    <name>兴趣</name>
    <description>兴趣</description>
    <feudDescription>轻微争执</feudDescription>
    <afterEvent>
      <mood>0</mood>
    </afterEvent>
    <afterEvent>
      <mood>0</mood>
      <fadeChance>33</fadeChance>
      <extraLossChance>50</extraLossChance>
    </afterEvent>
    <afterEvent>
      <mood>-1</mood>
    </afterEvent>
    <afterEvent>
      <mood>-1</mood>
      <extraLossChance>50</extraLossChance>
    </afterEvent>
  </intensity>
