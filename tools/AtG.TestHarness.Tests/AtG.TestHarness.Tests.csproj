<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Legacy top-level cases are intentionally discovered by the xUnit bridge. -->
    <NoWarn>$(NoWarn);CS7022;CS8321</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AtG.TestHarness\AtG.TestHarness.csproj" />
    <Compile Include="..\AtG.Testing\LegacyRunnerXunitBridge.cs" Link="LegacyRunnerXunitBridge.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
</Project>
