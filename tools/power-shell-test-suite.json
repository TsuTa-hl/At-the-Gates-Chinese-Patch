{
  "SchemaVersion": 2,
  "PathCategories": [
    {
      "Id": "text",
      "Patterns": [
        "translations/zh-CN.json",
        "translations/entries.csv",
        "translations/runtime-text-key-additions.json",
        "translations/config-node-*.json",
        "source/English.original.xml",
        "source/Content/Config/**",
        "tools/Build-ChineseXml.ps1",
        "tools/Build-ConfigNodePatch.ps1"
      ]
    },
    {
      "Id": "composite",
      "Patterns": [
        "translations/composite-text-rules.json",
        "translations/composite-entry-specific-rules.json",
        "translations/runtime-display-strings.json",
        "translations/concept-key-translations.json",
        "tools/Build-RuntimeText.ps1",
        "tools/Export-ConceptKeyTranslations.ps1",
        "tools/AtG.RuntimeText/DisplayStringLocalizer.cs",
        "tools/AtG.ManagedRewrite/CompositeTextCatalog.cs",
        "tools/AtG.ManagedRewrite/ConceptTooltipCatalog.cs"
      ]
    },
    {
      "Id": "managed",
      "Patterns": [
        "translations/hardcoded-*.json",
        "tools/Build-Il*.ps1",
        "tools/Build-HardcodedPatch.ps1",
        "tools/Build-OffsetStringPatch.ps1",
        "tools/AtG.ManagedRewrite/**",
        "tools/AtG.IlRewrite/**",
        "source/*.original.dll",
        "source/*.original.exe"
      ]
    },
    {
      "Id": "font",
      "Patterns": [
        "translations/runtime-glyph-warmset.tsv",
        "tools/Build-Font*.ps1",
        "tools/New-XnaMergedSpriteFont.ps1",
        "tools/Export-RuntimeGlyphWarmset.ps1",
        "tools/AtG.RuntimeText/DynamicGlyph*.cs",
        "tools/AtG.RuntimeText/RuntimeGlyph*.cs",
        "tools/AtG.RuntimeText/Glyph*.cs",
        "source/fonts-original/**"
      ]
    },
    {
      "Id": "automation",
      "Patterns": [
        "docs/agent/black-box-scenarios.json",
        "docs/agent/black-box/**",
        "tools/AtG.TestHarness/**",
        "tools/AtG.TestHarness.Tests/**",
        "tools/Test-GameLaunch*.ps1"
      ]
    },
    {
      "Id": "documentation",
      "Patterns": [
        "AGENTS.md",
        "README.md",
        "docs/agent/**",
        "docs/review/**"
      ]
    },
    {
      "Id": "verification",
      "Patterns": [
        "tools/Invoke-AtGVerification.ps1",
        "tools/AtGVerificationProfile.ps1",
        "tools/AtGTiming.ps1",
